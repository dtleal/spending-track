# Database
DATABASE_URL=postgresql://spendtrack:spendtrack123@db:5432/spendtrack
POSTGRES_USER=spendtrack
POSTGRES_PASSWORD=spendtrack123
POSTGRES_DB=spendtrack

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=expenses

# Redis
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Configuration
OPENAI_API_KEY=your-openai-api-key
FASTMCP_SERVER_URL=http://localhost:8001
AI_MODEL=gpt-4o-mini

# Google OAuth (required to start the backend; use placeholders if you
# don't need Google login, replace with real credentials to enable it)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Application
APP_NAME=SpendTrack
APP_VERSION=0.1.0
DEBUG=True

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]